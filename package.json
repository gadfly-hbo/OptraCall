{
  "name": "optracall",
  "version": "0.1.0-mvp.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "host": "node scripts/start-host.mjs",
    "dev:ui": "node scripts/frontend.mjs dev",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/frontend.mjs build && node scripts/stamp-build.mjs",
    "check:agent-sessions": "node scripts/check-agent-session-boundary.mjs",
    "check": "npm run check:agent-sessions && npm run test && npm run build",
    "preview": "node scripts/frontend.mjs preview",
    "start": "node scripts/trial-launcher.mjs start",
    "stop": "node scripts/trial-launcher.mjs stop",
    "update:trial": "node scripts/trial-launcher.mjs update"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "jszip": "3.10.1",
    "marked": "18.0.11",
    "marked-cjk-friendly": "0.1.2",
    "mysql2": "3.24.6",
    "node-sql-parser": "5.4.0",
    "pdfjs-dist": "6.2.108",
    "pg": "8.23.1",
    "pg-cursor": "2.22.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "5.0.1",
    "typebox": "1.3.27",
    "undici": "8.12.2",
    "unzipper": "0.10.14",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "undici": "8.12.2"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/pg-cursor": "2.7.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "rolldown": "1.2.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=25.0.0"
  }
}
