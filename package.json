{
  "name": "optracall",
  "version": "0.1.0-mvp.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "host": "node scripts/start-host.mjs",
    "dev:ui": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/stamp-build.mjs",
    "check": "npm run test && npm run build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "start": "node scripts/trial-launcher.mjs start",
    "stop": "node scripts/trial-launcher.mjs stop",
    "update:trial": "node scripts/trial-launcher.mjs update"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "undici": "8.12.2"
  },
  "overrides": {
    "undici": "8.12.2"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=25.0.0"
  }
}
